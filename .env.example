# EmailJS public contact form settings
VITE_SERVICE_ID=
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=

# Optional externally hosted resume URL (defaults to /resume.pdf)
VITE_RESUME_URL=

# Pulse API route. Set this in the Vercel build environment; it is public.
VITE_CHAT_ENDPOINT=/api/chat

# Server-only Vercel Function settings. Never prefix these with VITE_.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
